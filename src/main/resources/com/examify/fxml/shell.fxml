<?xml version="1.0" encoding="UTF-8"?>

<?import com.examify.view.IkonView?>
<?import com.examify.view.LatarAnimasi?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.examify.controller.ShellController" styleClass="latar">
    <LatarAnimasi/>
    <BorderPane>
        <left>
            <VBox styleClass="sidebar" spacing="6" prefWidth="250" minWidth="250">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding><Insets left="6" bottom="22"/></padding>
                    <ImageView fitWidth="34" fitHeight="34" smooth="true"><Image url="@../img/examifylogo.png" requestedWidth="136" requestedHeight="136" smooth="true"/></ImageView>
                    <HBox><Label text="Examify" styleClass="logo-teks"/><Label text="." styleClass="logo-titik"/></HBox>
                </HBox>
                <Label text="MENU" styleClass="teks-kecil">
                    <padding><Insets left="8" bottom="4"/></padding>
                </Label>
                <ToggleButton fx:id="tbKursus" text="Kursus Saya" styleClass="nav-item" maxWidth="Infinity"
                              onAction="#handleKursus">
                    <graphic><IkonView ikon="BUKU" ukuran="18"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="tbBankSoal" text="Bank Soal" styleClass="nav-item" maxWidth="Infinity"
                              onAction="#handleBankSoal">
                    <graphic><IkonView ikon="UJIAN" ukuran="18"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="tbSiswa" text="Siswa" styleClass="nav-item" maxWidth="Infinity"
                              onAction="#handleSiswa">
                    <graphic><IkonView ikon="PENGGUNA" ukuran="18"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="tbProfil" text="Profil &amp; Nilai" styleClass="nav-item" maxWidth="Infinity"
                              onAction="#handleProfil">
                    <graphic><IkonView ikon="PROFIL" ukuran="18"/></graphic>
                </ToggleButton>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnTema" styleClass="nav-item" maxWidth="Infinity"/>
                <HBox styleClass="kartu-profil-mini" spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblAvatar" styleClass="avatar" minWidth="38" minHeight="38" maxWidth="38" maxHeight="38"/>
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="lblNama" styleClass="judul-kartu" style="-fx-font-size: 13px;"/>
                        <Label fx:id="lblNis" styleClass="teks-kecil"/>
                    </VBox>
                </HBox>
                <Button text="Keluar" styleClass="nav-item" maxWidth="Infinity" onAction="#handleKeluar">
                    <graphic><IkonView ikon="KELUAR" ukuran="18"/></graphic>
                </Button>
            </VBox>
        </left>
        <center>
            <StackPane fx:id="spKonten"/>
        </center>
    </BorderPane>
</StackPane>
