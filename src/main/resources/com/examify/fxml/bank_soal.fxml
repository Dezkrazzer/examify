<?xml version="1.0" encoding="UTF-8"?>

<?import com.examify.view.IkonView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.examify.controller.BankSoalController" fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="24">
        <padding><Insets top="32" right="36" bottom="36" left="36"/></padding>

        <VBox spacing="4">
            <Label text="Bank Soal CBT" styleClass="judul-halaman"/>
            <Label text="Kelola seluruh paket ujian CBT, rancang butir soal, atur durasi, KKM, dan token ujian." styleClass="subjudul"/>
        </VBox>

        <HBox spacing="18">
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="UJIAN" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblTotalUjian" styleClass="angka-tile"/><Label text="Total Paket Ujian" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="DOKUMEN" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblTotalSoal" styleClass="angka-tile"/><Label text="Total Butir Soal" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="CENTANG" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblTotalPeserta" styleClass="angka-tile"/><Label text="Ujian Dikerjakan" styleClass="teks-redup"/></VBox>
            </HBox>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Daftar Paket Ujian CBT" styleClass="judul-bagian"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="kotak-cari" alignment="CENTER_LEFT" spacing="6" prefWidth="280">
                <IkonView ikon="CARI" ukuran="16"/>
                <TextField fx:id="tfCari" promptText="Cari kode ujian atau mapel..." HBox.hgrow="ALWAYS"/>
            </HBox>
            <Button text="+ Buat Ujian Baru" onAction="#handleTambahUjianBaru" styleClass="tombol-utama"/>
        </HBox>

        <FlowPane fx:id="fpUjian" hgap="20" vgap="20"/>
        <Label fx:id="lblKosong" text="Tidak ada paket ujian yang cocok dengan pencarian." styleClass="teks-redup" visible="false" managed="false"/>
    </VBox>
</ScrollPane>
