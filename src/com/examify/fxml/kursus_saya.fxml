<?xml version="1.0" encoding="UTF-8"?>

<?import com.examify.view.IkonView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.examify.controller.KursusSayaController" fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="24">
        <padding><Insets top="32" right="36" bottom="36" left="36"/></padding>

        <VBox spacing="4">
            <Label fx:id="lblSapaan" styleClass="judul-halaman"/>
            <Label text="Lanjutkan belajar dari kursus yang sedang kamu ikuti." styleClass="subjudul"/>
        </VBox>

        <HBox spacing="18">
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="BUKU" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblJumlahKursus" styleClass="angka-tile"/><Label text="Kursus diikuti" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="CENTANG" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblMateriSelesai" styleClass="angka-tile"/><Label text="Materi selesai" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="UJIAN" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblUjianDikerjakan" styleClass="angka-tile"/><Label text="Ujian dikerjakan" styleClass="teks-redup"/></VBox>
            </HBox>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Kursus Saya" styleClass="judul-bagian"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="kotak-cari" alignment="CENTER_LEFT" spacing="6" prefWidth="280">
                <IkonView ikon="CARI" ukuran="16"/>
                <TextField fx:id="tfCari" promptText="Cari kursus..." HBox.hgrow="ALWAYS"/>
            </HBox>
            <ComboBox fx:id="cbFilter" prefWidth="170"/>
            <ComboBox fx:id="cbUrut" prefWidth="190"/>
        </HBox>

        <FlowPane fx:id="fpKursus" hgap="20" vgap="20"/>
        <Label fx:id="lblKosong" text="Tidak ada kursus yang cocok." styleClass="teks-redup" visible="false" managed="false"/>
    </VBox>
</ScrollPane>
