<?xml version="1.0" encoding="UTF-8"?>

<?import com.examify.view.IkonView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.examify.controller.GuruDetailSiswaController" fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="22">
        <padding><Insets top="32" right="36" bottom="36" left="36"/></padding>

        <!-- Tombol Kembali -->
        <HBox alignment="CENTER_LEFT">
            <Button text="Kembali ke Data Siswa" styleClass="tombol-hantu" onAction="#handleKembali">
                <graphic><IkonView ikon="PANAH_KIRI" ukuran="16"/></graphic>
            </Button>
        </HBox>

        <!-- Kartu Identitas Siswa -->
        <HBox styleClass="kaca" spacing="22" alignment="CENTER_LEFT">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
            <Label fx:id="lblAvatar" styleClass="avatar, avatar-besar" minWidth="86" minHeight="86" maxWidth="86" maxHeight="86"/>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="lblNama" styleClass="judul-halaman"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblKelas" styleClass="badge"/>
                    <Label fx:id="lblNis" styleClass="badge"/>
                    <HBox fx:id="hbStatusAktif" alignment="CENTER" spacing="5">
                        <Circle fx:id="dotStatus" radius="4"/>
                        <Label fx:id="lblStatusAktif"/>
                    </HBox>
                </HBox>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label text="Rata-rata Nilai CBT" styleClass="teks-kecil"/>
                <Label fx:id="lblRataRata" styleClass="skor-besar" style="-fx-font-size: 40px;"/>
            </VBox>
        </HBox>

        <!-- Statistik Capaian -->
        <HBox spacing="18">
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="UJIAN" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblTotalUjian" styleClass="angka-tile"/><Label text="Total Ujian Diikuti" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="PIALA" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblTotalLulus" styleClass="angka-tile"/><Label text="Ujian Lulus" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="BINTANG" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblNilaiTertinggi" styleClass="angka-tile"/><Label text="Nilai Tertinggi" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="BUKU" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblMateriSelesai" styleClass="angka-tile"/><Label text="Materi Selesai" styleClass="teks-redup"/></VBox>
            </HBox>
        </HBox>

        <!-- Riwayat Ujian -->
        <VBox styleClass="kaca" spacing="14">
            <HBox alignment="CENTER_LEFT">
                <Label text="Riwayat Pengerjaan Ujian CBT" styleClass="judul-bagian" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="Hasil evaluasi CBT resmi siswa" styleClass="teks-kecil"/>
            </HBox>

            <!-- Empty state -->
            <VBox fx:id="vbKosong" alignment="CENTER" spacing="12" visible="false" managed="false">
                <padding><Insets top="40" right="20" bottom="40" left="20"/></padding>
                <IkonView ikon="FOLDER_KOSONG" ukuran="58" style="-fx-stroke: -teks-redup;"/>
                <Label text="Belum Ada Riwayat Ujian" styleClass="judul-bagian"/>
                <Label text="Siswa ini belum pernah mengerjakan ujian CBT." styleClass="teks-redup"/>
            </VBox>

            <!-- Tabel Riwayat 5 Kolom Utama + Sertifikat -->
            <TableView fx:id="tvRiwayat" prefHeight="360">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="Belum ada riwayat ujian."/></placeholder>
                <columns>
                    <TableColumn fx:id="colNamaUjian" text="Nama Ujian" prefWidth="230" minWidth="200"/>
                    <TableColumn fx:id="colTanggal" text="Tanggal" prefWidth="140" minWidth="130"/>
                    <TableColumn fx:id="colWaktuPengerjaan" text="Waktu Pengerjaan" prefWidth="130" minWidth="120"/>
                    <TableColumn fx:id="colSkor" text="Skor" prefWidth="80" minWidth="75"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110" minWidth="100"/>
                    <TableColumn fx:id="colSertifikat" text="Sertifikat" prefWidth="110" minWidth="100" sortable="false"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
