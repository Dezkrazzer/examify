<?xml version="1.0" encoding="UTF-8"?>

<?import com.examify.view.IkonView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.examify.controller.GuruSiswaController" fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="24">
        <padding><Insets top="32" right="36" bottom="36" left="36"/></padding>

        <VBox spacing="4">
            <Label text="Data Siswa" styleClass="judul-halaman"/>
            <Label text="Daftar seluruh siswa terdaftar, informasi kelas, dan riwayat capaian ujian CBT." styleClass="subjudul"/>
        </VBox>

        <HBox spacing="18">
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="PENGGUNA" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblTotalSiswa" styleClass="angka-tile"/><Label text="Total Siswa Terdaftar" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="CENTANG" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblTotalUjianDikerjakan" styleClass="angka-tile"/><Label text="Total Ujian Dikerjakan" styleClass="teks-redup"/></VBox>
            </HBox>
            <HBox styleClass="kaca, tile-statistik" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <StackPane styleClass="ikon-fitur"><IkonView ikon="PIALA" ukuran="22"/></StackPane>
                <VBox><Label fx:id="lblRataRataSemua" styleClass="angka-tile"/><Label text="Rata-rata Nilai CBT" styleClass="teks-redup"/></VBox>
            </HBox>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Daftar Siswa Terdaftar" styleClass="judul-bagian"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="kotak-cari" alignment="CENTER_LEFT" spacing="6" prefWidth="280">
                <IkonView ikon="CARI" ukuran="16"/>
                <TextField fx:id="tfCari" promptText="Cari nama, kelas, atau NIS..." HBox.hgrow="ALWAYS"/>
            </HBox>
        </HBox>

        <FlowPane fx:id="fpSiswa" hgap="20" vgap="20"/>
        <Label fx:id="lblKosong" text="Tidak ada siswa yang cocok dengan pencarian." styleClass="teks-redup" visible="false" managed="false"/>
    </VBox>
</ScrollPane>
